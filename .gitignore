.streamlit/secrets.toml
.streamlit/secrets.toml.local

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Output files
gallery_uploads/*.jpg
gallery_uploads/*.png
!gallery_uploads/.gitkeep
*.pdf
