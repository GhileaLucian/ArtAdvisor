# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyTorch large model weights (distribute via releases or git-lfs)
*.pth
*.pt
*.bin
*.onnx
!models/.gitkeep
!models/README.md

